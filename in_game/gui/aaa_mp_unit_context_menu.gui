# Military Presence - army right-click context menu integration
#
# EU5 GUI templates/types use first-definition-wins precedence. Tested mods use
# an aaa_ prefix for early GUI overrides; this file therefore loads before
# vanilla context_menu.gui and defines the two unit context-menu types first.
# Keep the same types collection name as vanilla for the overridden definitions.

types ContextMenuSpecificTypes
{
	# Reusable patrol section. The datacontext must be a Unit.
	type MpPatrolContextMenuActions = ContextMenuEntryListSubSection {
		visible = "[And(Unit.IsArmy, Unit.GetCountry.IsPlayer)]"

		# Route editing is available only while the patrol is stopped. The editor
		# supports multi-province add/remove in one selection session.
		ContextMenuActionEntry = {
			visible = "[Not(Unit.MakeScope.GetVariable('mp_patrol_active').IsSet)]"
			title = "mp_edit_patrol_route"
			actor = "[Player]"
			parameter = {
				parameter_name = "mp_patrol_unit"
				parameter_value = "[Unit.MakeScope]"
			}
			left_action = { action_name = "mp_edit_patrol_route" }

			blockoverride "entry_icon_texture" {
				texture = "gfx/interface/icons/unit_actions/land_levies_rally_point.dds"
			}
			blockoverride "entry_text" {
				text = "mp_edit_patrol_route"
			}
		}

		# Start only after a committed route exists and only while inactive.
		ContextMenuActionEntry = {
			visible = "[And(Unit.MakeScope.GetVariable('mp_patrol_route_configured').IsSet, Not(Unit.MakeScope.GetVariable('mp_patrol_active').IsSet))]"
			title = "mp_start_military_patrol"
			actor = "[Player]"
			parameter = {
				parameter_name = "mp_patrol_unit"
				parameter_value = "[Unit.MakeScope]"
			}
			left_action = { action_name = "mp_start_military_patrol" }

			blockoverride "entry_icon_texture" {
				texture = "gfx/interface/icons/unit_actions/regulars.dds"
			}
			blockoverride "entry_text" {
				text = "mp_start_military_patrol"
			}
		}

		# Stop only while this army is actually patrolling.
		ContextMenuActionEntry = {
			visible = "[Unit.MakeScope.GetVariable('mp_patrol_active').IsSet]"
			title = "mp_stop_military_patrol"
			actor = "[Player]"
			parameter = {
				parameter_name = "mp_patrol_unit"
				parameter_value = "[Unit.MakeScope]"
			}
			left_action = { action_name = "mp_stop_military_patrol" }

			blockoverride "entry_icon_texture" {
				texture = "gfx/interface/icons/unit_actions/regulars.dds"
			}
			blockoverride "entry_text" {
				text = "mp_stop_military_patrol"
			}
			blockoverride "button_texture" {
				using = button_regular_red_texture
			}
		}
	}

	# Unit Overview / Outliner path: datacontext is already Unit.
	type UnitContextMenu = ContextMenuBase {
		blockoverride "contextmenu_content" {
			ContextMenuSection = {
				blockoverride "title_icon" {
					icon = {
						size = { 32 32 }
						texture = "gfx/interface/icons/unit_recruit/normal_training.dds"
					}
				}

				blockoverride "title_text" {
					raw_text = "[Unit.GetNameWithNoTooltip]"
				}

				blockoverride "contextmenu_entries" {
					# Preserve vanilla's per-instance hook (e.g. Go To in Unit Overview).
					block "unit_contextmenu_pre_entries" {}

					MpPatrolContextMenuActions = {}

					# Preserve vanilla quick unit actions unchanged.
					ContextMenuEntryListSubSection = {
						datacontext = "[Unit.GetQuickUnitActions]"
						datacontext = "[Pin('unit_actions')]"
						visible = "[DataModelHasItems(QuickUnitActions.AccessList)]"
						datamodel = "[QuickUnitActions.AccessList]"
						item = { UnitContextMenuActionItem = {} }
					}
				}
			}
		}
	}

	# Map army markers use UnitMarkerContextMenu and need their concrete Unit
	# explicitly rebound before evaluating the patrol section.
	type UnitMarkerContextMenu = ContextMenuBase {
		blockoverride "contextmenu_content" {
			ContextMenuSection = {
				blockoverride "title_icon" {
					icon = {
						size = { 24 24 }
						texture = "gfx/interface/icons/unit_recruit/normal_training.dds"
					}
				}

				blockoverride "title_text" {
					raw_text = "[UnitMarkerItem.GetContextMenuTitle]"
				}

				blockoverride "contextmenu_entries" {
					MpPatrolContextMenuActions = {
						datacontext = "[UnitMarkerItem.GetUnit]"
					}

					# Preserve vanilla marker quick actions unchanged.
					ContextMenuEntryListSubSection = {
						datacontext = "[UnitMarkerItem.GetQuickUnitActions]"
						datacontext = "[Pin('unit_actions')]"
						visible = "[DataModelHasItems(QuickUnitActions.AccessList)]"
						datamodel = "[QuickUnitActions.AccessList]"
						item = { UnitContextMenuActionItem = {} }
					}
				}
			}
		}
	}
}
